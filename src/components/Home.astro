---
import Base from '../layouts/Base.astro';
import ContactForm from './ContactForm.astro';
import { Image } from 'astro:assets';
import portrait from '../../Photos/Personal/hero.jpeg';
import aboutOne from '../../Photos/Personal/about_1.jpeg';
import aboutTwo from '../../Photos/Personal/about_2.jpeg';
import { site, type Locale } from '../site';
import { useUi } from '../i18n/ui';
import { getApps, mediaFor } from '../lib/apps';
import { getSubstackPosts, substackFeedUrl } from '../lib/posts';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useUi(locale);
const apps = await getApps(locale);
const posts = await getSubstackPosts(locale);
---

<Base locale={locale} title={t.meta.title} description={t.meta.description}>
  <section class="hero">
    <div class="wrap">
      <p class="eyebrow" data-reveal>{t.hero.eyebrow}</p>
      <div class="hero-grid">
        <div>
          <h1 data-reveal>
            {t.hero.title.map((line) => <span>{line}</span>)}
          </h1>
          <p class="lede type-line" data-reveal data-typewriter data-phrases={JSON.stringify(t.hero.line)}>
            <span data-type-text class="is-mark" aria-hidden="true">{t.hero.line[0]}</span><span class="type-caret" aria-hidden="true"></span>
            <span class="sr-only">{t.hero.line.join(' ')}</span>
          </p>
          <p class="support" data-reveal>{t.hero.support}</p>
          <a class="text-link" href="#work" data-reveal>
            {t.hero.cta}
            <span aria-hidden="true">↓</span>
          </a>
        </div>
        <figure class="portrait" data-reveal>
          <Image
            src={portrait}
            alt={t.hero.photo}
            widths={[480, 720, 960]}
            sizes="(min-width: 800px) 26rem, 100vw"
            loading="eager"
            fetchpriority="high"
          />
        </figure>
      </div>
    </div>
  </section>

  <section class="section" id="work">
    <div class="wrap">
      <div class="section-head">
        <span class="section-index">{t.work.index}</span>
        <p class="section-label">{t.work.label}</p>
      </div>
      {
        apps.length === 0 ? (
          <p class="support">{t.work.empty}</p>
        ) : (
          apps.map((app) => {
            const media = mediaFor(app.data.appId);
            return (
              <article class="project">
                <a class="project-link" href={`/${locale}/work/${app.data.appId}`}>
                  <div class="project-copy">
                    <p class="project-meta">
                      {app.data.year} · <span class="store-status">{app.data.status}<span class="pulse" aria-hidden="true"></span></span>
                    </p>
                    <h2>{app.data.title}</h2>
                    <p class="project-summary">{app.data.summary}</p>
                  </div>
                  <div class="shot">
                    <Image
                      src={media.cover}
                      alt={media.coverAlt[locale]}
                      widths={[480, 720, 960]}
                      sizes="(min-width: 800px) 34rem, 100vw"
                    />
                  </div>
                  <span class="text-link">
                    {t.work.view}
                    <span aria-hidden="true">→</span>
                  </span>
                </a>
              </article>
            );
          })
        )
      }
      <div class="roles">
        <p class="section-label">{t.about.experienceLabel}</p>
        {
          t.about.roles.map((role) => (
            <article class="role-item">
              <div>
                <h3>{role.name}</h3>
                <p class="meta">{role.meta}</p>
              </div>
              <div>
                <p>{role.text}</p>
                {role.href ? (
                  <a class="text-link" href={role.href} target="_blank" rel="noopener noreferrer">
                    {t.project.store}
                    <span aria-hidden="true">↗</span>
                  </a>
                ) : null}
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="stack" aria-labelledby="stack-title">
    <div class="wrap">
      <div class="stack-frame">
        <div class="stack-layout">
          <div>
            <p class="section-label" id="stack-title">{t.stack.label}</p>
            <p class="stack-line">{t.stack.line}</p>
          </div>
          <div class="stack-rows">
            {
              [t.stack.groups.slice(0, 3), t.stack.groups.slice(3)].map((row) => (
                <div class="stack-row">
                  {row.map((group) => (
                    <div class="stack-group">
                      <p class="stack-k">{group.k}</p>
                      <p class="stack-v">
                        {group.sdks ? (
                          <span class="sdk">
                            <button type="button" class="sdk-trigger" aria-expanded="false" aria-controls="apple-sdks">
                              {group.v}
                            </button>
                            <span class="sdk-pop" id="apple-sdks" role="tooltip">
                              {t.stack.sdks.join(' · ')}
                            </span>
                          </span>
                        ) : (
                          group.v
                        )}
                      </p>
                    </div>
                  ))}
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="about">
    <div class="wrap">
      <div class="section-head">
        <span class="section-index">{t.about.index}</span>
        <p class="section-label">{t.about.label}</p>
      </div>
      <h2>{t.about.title}</h2>
      <div class="about-grid">
      <div class="copy">
        {t.about.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
      </div>
      <dl class="facts">
        {
          t.about.facts.map((fact) => (
            <div>
              <dt>{fact.k}</dt>
              <dd>{fact.v}</dd>
            </div>
          ))
        }
      </dl>
      </div>
      <div class="about-photos">
        <figure>
          <Image
            src={aboutOne}
            alt={t.hero.photo}
            widths={[480, 720, 960]}
            sizes="(min-width: 800px) 34rem, 50vw"
          />
        </figure>
        <figure>
          <Image
            src={aboutTwo}
            alt={t.hero.photo}
            widths={[480, 720, 960]}
            sizes="(min-width: 800px) 34rem, 50vw"
          />
        </figure>
      </div>
    </div>
  </section>

  <section class="section" id="journal">
    <div class="wrap">
      <div class="section-head">
        <span class="section-index">{t.journal.index}</span>
        <p class="section-label">{t.journal.label}</p>
      </div>
      <h2>{t.journal.title}<span class="ellipsis" aria-hidden="true"><span>.</span><span>.</span><span>.</span></span></h2>
      <div class="journal-grid">
        <div class="copy">
          <p>{t.journal.lede}</p>
          <div class="journal-links">
            <a class="text-link" href={site.substack} rel="me noopener" target="_blank">
              {t.journal.substack}
              <span aria-hidden="true">↗</span>
            </a>
            <a class="text-link" href={site.x} rel="me noopener" target="_blank">
              {t.journal.x}
              <span aria-hidden="true">↗</span>
            </a>
          </div>
        </div>
        <div>
          <p class="section-label">{t.journal.essays}</p>
          <div data-essays data-locale={locale} data-feed={substackFeedUrl}>
            {
              posts.length === 0 ? (
                <p class="support">{t.journal.empty}</p>
              ) : (
                <ol class="posts">
                  {posts.map((post) => (
                    <li>
                      <a class="post" href={post.href} rel="noopener" target="_blank">
                        {post.date ? <time>{post.date}</time> : null}
                        <h3>{post.title}</h3>
                        {post.excerpt ? <p>{post.excerpt}</p> : null}
                      </a>
                    </li>
                  ))}
                </ol>
              )
            }
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="contact">
    <div class="wrap">
      <div class="section-head">
        <span class="section-index">{t.contact.index}</span>
        <p class="section-label">{t.contact.label}</p>
      </div>
      <h2>{t.contact.title}</h2>
      <div class="contact-grid">
      <div class="copy">
        <p>{t.contact.lede}</p>
        <p>
          <a class="contact-email" href={`mailto:${site.email}`}>{site.email}</a>
        </p>
      </div>
      <ContactForm locale={locale} />
      </div>
    </div>
  </section>
</Base>

<script>
  function bindTypewriter() {
    const el = document.querySelector('[data-typewriter]');
    const text = el?.querySelector('[data-type-text]');
    if (!(el instanceof HTMLElement) || !(text instanceof HTMLElement)) return;
    if (el.dataset.bound === 'true') return;

    let phrases: string[] = [];
    try {
      phrases = JSON.parse(el.dataset.phrases || '[]');
    } catch {
      return;
    }
    if (phrases.length < 2) return;

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduced) {
      text.textContent = phrases[0];
      return;
    }

    el.dataset.bound = 'true';
    let phrase = 0;
    let index = phrases[0].length;
    let deleting = false;
    let timer = 0;

    const show = (count: number) => {
      text.textContent = phrases[phrase].slice(0, count);
      text.classList.toggle('is-mark', count > 0);
    };

    const tick = () => {
      if (!el.isConnected) return;
      const current = phrases[phrase];
      if (!deleting) {
        index += 1;
        show(index);
        if (index >= current.length) {
          deleting = true;
          timer = window.setTimeout(tick, 1700);
          return;
        }
        timer = window.setTimeout(tick, 46);
        return;
      }
      index -= 1;
      if (index <= 0) {
        phrase = (phrase + 1) % phrases.length;
        index = 0;
        deleting = false;
        show(0);
        timer = window.setTimeout(tick, 320);
        return;
      }
      show(index);
      timer = window.setTimeout(tick, 26);
    };

    timer = window.setTimeout(() => {
      deleting = true;
      tick();
    }, 1400);

    document.addEventListener(
      'astro:before-swap',
      () => {
        window.clearTimeout(timer);
      },
      { once: true },
    );
  }

  function bindSdk() {
    document.querySelectorAll('.sdk').forEach((sdk) => {
      if (!(sdk instanceof HTMLElement) || sdk.dataset.bound === 'true') return;
      const button = sdk.querySelector('.sdk-trigger');
      if (!(button instanceof HTMLButtonElement)) return;
      sdk.dataset.bound = 'true';
      const setOpen = (open: boolean) => {
        sdk.classList.toggle('is-open', open);
        button.setAttribute('aria-expanded', String(open));
      };
      button.addEventListener('click', () => setOpen(!sdk.classList.contains('is-open')));
      document.addEventListener('pointerdown', (event) => {
        if (event.target instanceof Node && sdk.contains(event.target)) return;
        setOpen(false);
      });
    });
  }

  function plain(value: string) {
    return value.replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').trim();
  }

  function publishedAt(value: string) {
    if (/^\d{4}-\d{2}-\d{2} \d{2}:\d{2}:\d{2}$/.test(value)) return new Date(`${value.replace(' ', 'T')}Z`);
    return new Date(value);
  }

  async function bindEssays() {
    const root = document.querySelector('[data-essays]');
    if (!(root instanceof HTMLElement) || root.dataset.bound === 'true') return;
    const feed = root.dataset.feed;
    if (!feed?.startsWith('https://')) return;
    root.dataset.bound = 'true';

    try {
      const response = await fetch(
        `https://api.rss2json.com/v1/api.json?rss_url=${encodeURIComponent(feed)}&count=4`,
      );
      if (!response.ok || !root.isConnected) return;
      const data = (await response.json()) as {
        status?: string;
        items?: Array<{ title?: string; link?: string; description?: string; pubDate?: string }>;
      };
      if (data.status !== 'ok' || !Array.isArray(data.items) || !root.isConnected) return;

      const format = new Intl.DateTimeFormat(root.dataset.locale || 'en', {
        day: 'numeric',
        month: 'short',
        year: 'numeric',
      });
      const posts = data.items.flatMap((item) => {
        const title = plain(item.title ?? '');
        const href = item.link ?? '';
        if (!title || !href.startsWith('https://')) return [];
        const excerpt = plain(item.description ?? '');
        const short = excerpt.length <= 180 ? excerpt : `${excerpt.slice(0, 177).trimEnd()}…`;
        const when = publishedAt(item.pubDate ?? '');
        return [
          {
            title,
            href,
            excerpt: short === title ? '' : short,
            date: Number.isNaN(when.getTime()) ? '' : format.format(when),
          },
        ];
      });
      if (posts.length === 0 || !root.isConnected) return;

      const current = [...root.querySelectorAll('.post h3')].map((heading) => heading.textContent).join('\n');
      if (current === posts.map((post) => post.title).join('\n')) return;

      const list = document.createElement('ol');
      list.className = 'posts';
      for (const post of posts) {
        const item = document.createElement('li');
        const link = document.createElement('a');
        link.className = 'post';
        link.href = post.href;
        link.target = '_blank';
        link.rel = 'noopener';
        if (post.date) {
          const time = document.createElement('time');
          time.textContent = post.date;
          link.append(time);
        }
        const heading = document.createElement('h3');
        heading.textContent = post.title;
        link.append(heading);
        if (post.excerpt) {
          const copy = document.createElement('p');
          copy.textContent = post.excerpt;
          link.append(copy);
        }
        item.append(link);
        list.append(item);
      }
      root.replaceChildren(list);
    } catch {
      return;
    }
  }

  bindTypewriter();
  bindSdk();
  bindEssays();
  document.addEventListener('astro:page-load', () => {
    bindTypewriter();
    bindSdk();
    bindEssays();
  });
</script>
