---
import { Image } from 'astro:assets';
import Base from '../../../layouts/Base.astro';
import { isLocale, locales, type Locale } from '../../../site';
import { useUi } from '../../../i18n/ui';
import { getApps, mediaFor, render } from '../../../lib/apps';

export async function getStaticPaths() {
  const paths = [];
  for (const lang of locales) {
    const apps = await getApps(lang);
    for (const app of apps) {
      paths.push({
        params: { lang, slug: app.data.appId },
      });
    }
  }
  return paths;
}

const lang = Astro.params.lang;
const slug = Astro.params.slug;
if (!isLocale(lang) || !slug) {
  return Astro.redirect('/en/');
}
const locale: Locale = lang;
const app = (await getApps(locale)).find((entry) => entry.data.appId === slug);
if (!app) {
  return Astro.redirect(`/${locale}/`);
}
const t = useUi(locale);
const media = mediaFor(app.data.appId);
const { Content } = await render(app);
---

<Base locale={locale} title={t.project.metaTitle(app.data.title)} description={app.data.summary}>
  <article class="project-page">
    <div class="wrap">
      <a class="back" href={`/${locale}/#work`}>← {t.project.back}</a>
      <p class="meta">
        {app.data.year} · {app.data.platform} · <span class="store-status">{app.data.status}<span class="pulse" aria-hidden="true"></span></span>
      </p>
      <h1>{app.data.title}</h1>
      <div class="project-intro">
        <p class="lede">{app.data.summary}</p>
        <div>
          {app.data.role ? <p class="role">{app.data.role}</p> : null}
          <a class="text-link store" href={app.data.storeUrl}>
            {t.project.store}
            <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
    </div>

    <div class="gallery" data-gallery tabindex="0" aria-label={app.data.title}>
      {
        [...media.shots, ...media.shots].map((shot, index) => {
          const clone = index >= media.shots.length;
          return (
            <figure data-clone={clone ? '' : undefined} aria-hidden={clone ? 'true' : undefined}>
              <Image
                src={shot.src}
                alt={clone ? '' : shot.alt[locale]}
                widths={[360, 540, 720]}
                sizes="16.5rem"
                loading={index === 0 ? 'eager' : 'lazy'}
              />
            </figure>
          );
        })
      }
    </div>

    <div class="wrap project-body">
      <div class="prose">
        <Content />
      </div>
      <div>
        <h2>{t.project.includes}</h2>
        <ul class="points">
          {app.data.points.map((point) => <li>{point}</li>)}
        </ul>
      </div>
    </div>
  </article>
</Base>

<script>
  function bindGalleries() {
    document.querySelectorAll('[data-gallery]').forEach((gallery) => {
      if (!(gallery instanceof HTMLElement) || gallery.dataset.bound === 'true') return;
      gallery.dataset.bound = 'true';

      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (reduced) return;

      let paused = false;
      let idle = 0;
      let dragging = false;
      let startX = 0;
      let startScroll = 0;
      let frame = 0;
      let pos = gallery.scrollLeft;
      let expected = gallery.scrollLeft;
      let last = performance.now();

      const half = () => gallery.scrollWidth / 2;

      const write = (next) => {
        const width = half();
        if (width > 0) next = ((next % width) + width) % width;
        pos = next;
        if (Math.abs(gallery.scrollLeft - next) < 0.5) return;
        expected = next;
        gallery.scrollLeft = next;
      };

      const tick = (now) => {
        if (!gallery.isConnected) return;
        const dt = Math.min(now - last, 50);
        last = now;
        if (!paused && !dragging) write(pos + (28 * dt) / 1000);
        frame = requestAnimationFrame(tick);
      };

      gallery.addEventListener(
        'scroll',
        () => {
          if (dragging || Math.abs(gallery.scrollLeft - expected) < 1.5) return;
          const width = half();
          let next = gallery.scrollLeft;
          if (width > 0 && next >= width) next -= width;
          pos = next;
          expected = next;
          if (Math.abs(gallery.scrollLeft - next) >= 1) gallery.scrollLeft = next;
        },
        { passive: true },
      );

      const pause = () => {
        paused = true;
        window.clearTimeout(idle);
      };

      const resume = () => {
        window.clearTimeout(idle);
        idle = window.setTimeout(() => {
          paused = false;
        }, 900);
      };

      gallery.addEventListener('pointerdown', (event) => {
        if (event.pointerType === 'mouse' && event.button !== 0) return;
        dragging = true;
        startX = event.clientX;
        startScroll = gallery.scrollLeft;
        try {
          gallery.setPointerCapture(event.pointerId);
        } catch {
          /* pointer capture needs a real pointer */
        }
        pause();
      });

      gallery.addEventListener('pointermove', (event) => {
        if (!dragging) return;
        const width = half();
        const next = startScroll - (event.clientX - startX);
        if (width > 0) write(next);
      });

      const endDrag = () => {
        if (!dragging) return;
        dragging = false;
        pos = gallery.scrollLeft;
        resume();
      };

      gallery.addEventListener('pointerup', endDrag);
      gallery.addEventListener('pointercancel', endDrag);

      gallery.addEventListener(
        'wheel',
        (event) => {
          const useX = Math.abs(event.deltaX) > Math.abs(event.deltaY);
          const delta = useX ? event.deltaX : event.deltaY;
          if (delta === 0) return;
          event.preventDefault();
          const unit = event.deltaMode === 1 ? 16 : event.deltaMode === 2 ? gallery.clientWidth : 1;
          write(pos + delta * unit);
          pause();
          resume();
        },
        { passive: false },
      );

      frame = requestAnimationFrame(tick);
      document.addEventListener(
        'astro:before-swap',
        () => {
          cancelAnimationFrame(frame);
        },
        { once: true },
      );
    });
  }

  bindGalleries();
  document.addEventListener('astro:page-load', bindGalleries);
</script>
