---
import { Image } from 'astro:assets';
import Base from '../../../layouts/Base.astro';
import { isLocale, locales, type Locale } from '../../../site';
import { useUi } from '../../../i18n/ui';
import { getApps, mediaFor, render } from '../../../lib/apps';
import type { Device } from '../../../lib/media';

export async function getStaticPaths() {
  const paths = [];
  for (const lang of locales) {
    const apps = await getApps(lang);
    for (const app of apps) {
      paths.push({
        params: { lang, slug: app.data.appId },
      });
    }
  }
  return paths;
}

const lang = Astro.params.lang;
const slug = Astro.params.slug;
if (!isLocale(lang) || !slug) {
  return Astro.redirect('/en/');
}
const locale: Locale = lang;
const app = (await getApps(locale)).find((entry) => entry.data.appId === slug);
if (!app) {
  return Astro.redirect(`/${locale}/`);
}
const t = useUi(locale);
const media = mediaFor(app.data.appId);
const { Content } = await render(app);
const devices: { id: Device; label: string; widths: number[]; sizes: string }[] = [
  { id: 'iphone', label: 'iPhone', widths: [360, 540, 720], sizes: '16.5rem' },
  { id: 'ipad', label: 'iPad', widths: [480, 720, 960], sizes: '24rem' },
];
---

<Base locale={locale} title={t.project.metaTitle(app.data.title)} description={app.data.summary}>
  <article class="project-page">
    <div class="wrap">
      <a class="back" href={`/${locale}/#work`}>← {t.project.back}</a>
      <p class="meta">
        {app.data.year} · {app.data.platform} · <span class="store-status">{app.data.status}<span class="pulse" aria-hidden="true"></span></span>
      </p>
      <h1>{app.data.title}</h1>
      <div class="project-intro">
        <p class="lede">{app.data.summary}</p>
        <div>
          {app.data.role ? <p class="role">{app.data.role}</p> : null}
          <div class="project-links">
            <a class="text-link store" href={app.data.storeUrl} target="_blank" rel="noopener noreferrer">
              {t.project.store}
              <span aria-hidden="true">↗</span>
            </a>
            {app.data.appId === 'somada' && (
              <a class="text-link" href={`/${locale}/somada/support`}>{t.project.support}</a>
            )}
          </div>
        </div>
      </div>
    </div>

    <div class="wrap device-switch" role="tablist" aria-label={t.project.devicesLabel}>
      {
        devices.map((device, index) => (
          <button
            type="button"
            role="tab"
            id={`tab-${device.id}`}
            aria-controls={`gallery-${device.id}`}
            aria-selected={index === 0 ? 'true' : 'false'}
            tabindex={index === 0 ? 0 : -1}
          >
            {device.label}
          </button>
        ))
      }
    </div>

    {
      devices.map((device, deviceIndex) => (
        <div
          class={`gallery gallery-${device.id}`}
          id={`gallery-${device.id}`}
          role="tabpanel"
          aria-labelledby={`tab-${device.id}`}
          hidden={deviceIndex !== 0}
        >
          {media.shots(device.id, locale).map((shot, index) => (
            <figure>
              <Image
                src={shot.src}
                alt={shot.alt}
                widths={device.widths}
                sizes={device.sizes}
                loading={deviceIndex === 0 && index < 2 ? 'eager' : 'lazy'}
              />
            </figure>
          ))}
        </div>
      ))
    }

    <div class="wrap project-body">
      <div class="prose">
        <Content />
      </div>
      <div>
        <h2>{t.project.includes}</h2>
        <ul class="points">
          {app.data.points.map((point) =>
            point === 'Free' || point === 'Gratis' ? (
              <li class="is-free">
                <a class="cta" href={app.data.storeUrl} target="_blank" rel="noopener noreferrer">
                  {t.project.start}
                </a>
              </li>
            ) : (
              <li>{point}</li>
            ),
          )}
        </ul>
      </div>
    </div>
  </article>
</Base>

<script>
  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('.device-switch [role="tab"]'));
  const select = (tab: HTMLButtonElement) => {
    for (const other of tabs) {
      const selected = other === tab;
      other.setAttribute('aria-selected', String(selected));
      other.tabIndex = selected ? 0 : -1;
      const panel = document.getElementById(other.getAttribute('aria-controls') ?? '');
      if (panel) {
        panel.hidden = !selected;
        if (selected) panel.scrollLeft = 0;
      }
    }
  };
  tabs.forEach((tab, index) => {
    tab.addEventListener('click', () => select(tab));
    tab.addEventListener('keydown', (event) => {
      if (event.key !== 'ArrowRight' && event.key !== 'ArrowLeft') return;
      const next = tabs[(index + (event.key === 'ArrowRight' ? 1 : tabs.length - 1)) % tabs.length];
      next.focus();
      select(next);
    });
  });
</script>

<noscript><style>.gallery[hidden] { display: flex !important; } .device-switch { display: none; }</style></noscript>
